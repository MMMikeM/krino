{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"lib": ["ES2022", "DOM"],
		"types": ["node"],
		"declaration": false,
		"isolatedDeclarations": false,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"noEmit": true,
		"rootDir": ".."
	},
	"include": ["**/*.ts", "../docs/pareto.ts"],
	"exclude": ["node_modules", ".raw"]
}
